{
  "name": "shelly-hermes-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable minimal coding-agent core for Android and Windows",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "npm run check && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "smoke:windows": "node --import tsx hosts/windows/smoke.ts",
    "demo": "tsx examples/demo.ts",
    "cli": "tsx hosts/windows/cli.ts",
    "test:windows-host": "node --import tsx --test test/windows-host.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
