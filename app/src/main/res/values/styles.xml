<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Luma</string>

    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_primary</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="TextAppearance.Luma" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Luma.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Luma.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Luma.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Luma.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Luma.ToolbarButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_toolbar_button</item>
    </style>

    <style name="Widget.Luma.PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_foreground</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_primary_button</item>
    </style>
</resources>
