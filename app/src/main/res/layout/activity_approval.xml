<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="变更审批"
        android:textAppearance="@style/TextAppearance.Luma.Title" />

    <TextView
        android:id="@+id/page_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="确认工具将要执行的操作"
        android:textAppearance="@style/TextAppearance.Luma.Caption" />

    <TextView
        android:id="@+id/affected_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="风险评估"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/risk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_chip_warning"
        android:minHeight="@dimen/touch_target"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_12"
        android:text="风险等级：工具调用需要人工确认"
        android:textColor="@color/status_error"
        android:textSize="@dimen/type_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/risk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="影响对象"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/affected_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_surface_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="@dimen/touch_target"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textAppearance="@style/TextAppearance.Luma.Body"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/summary_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="参数摘要"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/approval_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_surface_card"
        android:minHeight="@dimen/touch_target"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textAppearance="@style/TextAppearance.Luma.Body"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/expand_args"
        style="@style/Widget.Luma.ActionHint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center_vertical"
        android:text="@string/expand_args" />

    <TextView
        android:id="@+id/tool_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="工具"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tool_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_surface_card"
        android:minHeight="@dimen/touch_target"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textAppearance="@style/TextAppearance.Luma.SectionTitle" />

    <TextView
        android:id="@+id/args_section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="参数与变更内容"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tool_args"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_surface_card"
        android:fontFamily="monospace"
        android:gravity="start|top"
        android:lineSpacingExtra="@dimen/line_spacing_normal"
        android:visibility="gone"
        android:padding="@dimen/space_16"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="@dimen/type_caption" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_24"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="没有待审批项"
            android:textAppearance="@style/TextAppearance.Luma.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:maxWidth="@dimen/empty_state_text_width"
        android:lineSpacingExtra="@dimen/line_spacing_relaxed"
            android:text="高风险工具执行前会自动打开审批卡。当前没有需要确认的操作。"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Luma.Body"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/emptyAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:text="返回工作台"
            android:textAllCaps="false"
            android:textColor="@color/accent_foreground" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/reject"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="@dimen/touch_target"
            android:text="拒绝"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/approve"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:minHeight="@dimen/touch_target"
            android:text="允许一次"
            android:textAllCaps="false"
            android:textColor="@color/accent_foreground" />
    </LinearLayout>

    <Button
        android:id="@+id/always"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_button_secondary"
        android:minHeight="@dimen/touch_target"
        android:text="本次任务始终允许"
        android:textAllCaps="false"
        android:textColor="@color/text_primary" />
</LinearLayout>
