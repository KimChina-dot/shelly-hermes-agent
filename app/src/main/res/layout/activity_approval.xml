<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="变更审批"
        android:textAppearance="@style/TextAppearance.Luma.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="确认工具将要执行的操作"
        android:textAppearance="@style/TextAppearance.Luma.Caption" />

    <TextView
        android:id="@+id/affected_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="风险评估"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/risk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_warning"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="风险等级：工具调用需要人工确认"
        android:textColor="@color/status_error"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/risk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="影响对象"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/affected_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_card"
        android:ellipsize="end"
        android:maxLines="2"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textAppearance="@style/TextAppearance.Luma.Body"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="工具"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tool_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_card"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textAppearance="@style/TextAppearance.Luma.SectionTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="参数与变更内容"
        android:textAppearance="@style/TextAppearance.Luma.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tool_args"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_surface_card"
        android:fontFamily="monospace"
        android:gravity="start|top"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:scrollbars="vertical"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="当前没有待审批的工具调用"
        android:textAppearance="@style/TextAppearance.Luma.Body"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/reject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="48dp"
            android:text="拒绝"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/approve"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:minHeight="48dp"
            android:text="允许一次"
            android:textAllCaps="false"
            android:textColor="@color/accent_foreground" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/always"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:minHeight="48dp"
            android:text="本次任务始终允许"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
