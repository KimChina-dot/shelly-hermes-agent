<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="任务队列"
            android:textAppearance="@style/TextAppearance.Luma.Title" />

        <Button
            android:id="@+id/refreshTaskQueue"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_toolbar_button"
            android:text="刷新"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/taskQueueSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="0 项任务"
        android:textAppearance="@style/TextAppearance.Luma.Caption" />

    <LinearLayout
        android:id="@+id/taskQueueEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_weight="1"
        android:contentDescription="队列为空，可在对话页发起新任务">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="队列为空"
            android:textAppearance="@style/TextAppearance.Luma.SectionTitle" />

        <TextView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="任务提交后会在这里显示排队、运行、失败和取消状态；失败的队列任务可以重新排队。"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Luma.Body"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/startNewTaskFromQueue"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:text="去发起任务"
            android:textAllCaps="false"
            android:textColor="@color/accent_foreground" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/taskQueueScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/taskQueueList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
