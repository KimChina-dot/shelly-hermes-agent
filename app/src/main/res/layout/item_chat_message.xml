<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="start"
    android:maxWidth="720dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/space_4">

        <TextView
            android:id="@+id/typeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:background="@drawable/bg_chip_running"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:textColor="@color/accent_primary"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/roleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stateChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expandHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/expand_details"
            android:visibility="gone" />

        <TextView
            android:id="@+id/retryHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/retry_task"
            android:textColor="@color/status_error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/regenerateHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="重新生成"
            android:visibility="gone" />

        <TextView
            android:id="@+id/copyHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/copy_message"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans"
        android:lineSpacingExtra="2dp"
        android:maxWidth="720dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="@dimen/type_body" />

    <ImageView
        android:id="@+id/artifactImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/artifact_image"
        android:maxHeight="320dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/artifactActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/openArtifactHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:gravity="center_vertical"
            android:text="@string/open_artifact"
            android:textColor="@color/accent_primary" />

        <TextView
            android:id="@+id/shareArtifactHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_8"
            android:gravity="center_vertical"
            android:text="@string/share_artifact"
            android:textColor="@color/accent_primary" />

        <TextView
            android:id="@+id/saveArtifactHint"
            style="@style/Widget.Luma.ActionHint"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_8"
            android:gravity="center_vertical"
            android:text="@string/save_artifact"
            android:textColor="@color/accent_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/failureSuggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_chip_error"
        android:lineSpacingExtra="2dp"
        android:padding="@dimen/space_12"
        android:textColor="@color/status_error"
        android:textSize="@dimen/type_caption"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@color/surface_container"
        android:maxHeight="@dimen/detail_pane_max_height"
        android:scrollbars="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="@dimen/space_12"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="@dimen/type_micro" />
    </ScrollView>
</LinearLayout>
