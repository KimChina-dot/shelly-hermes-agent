<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_background"
        app:title="Luma"
        app:titleTextAppearance="@style/TextAppearance.Luma.Title">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/model_settings"
                android:drawableTop="@android:drawable/ic_menu_preferences"
                android:text="" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_background"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/workspace"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:maxWidth="220dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="@string/no_project"
                android:textAppearance="@style/TextAppearance.Luma.Caption" />

            <Button
                android:id="@+id/chooseWorkspace"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/project" />

            <TextView
                android:id="@+id/modelStatus"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:maxWidth="180dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:text="@string/model_disconnected"
                android:textAppearance="@style/TextAppearance.Luma.Caption" />

            <Button
                android:id="@+id/taskMode"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="ACT" />

            <Button
                android:id="@+id/agentProfile"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Coding" />

            <Button
                android:id="@+id/taskQueue"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tasks_zero" />

            <Button
                android:id="@+id/resumeTask"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/resume" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/taskStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Luma.Caption"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/contextBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.5"
            android:max="100"
            android:progressTint="@color/accent_primary"
            android:progressBackgroundTint="@color/border_subtle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/artifactGalleryScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/surface_background"
            android:fillViewport="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/artifactGalleryList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:text="@string/start_task"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Luma.Body"
            android:textColor="@color/text_secondary" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:maxWidth="760dp"
        android:background="@drawable/bg_chip_error"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/status_error" />

        <Button
            android:id="@+id/retry"
            style="@style/Widget.Luma.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/retry" />
    </LinearLayout>

    <Button
        android:id="@+id/approval"
        style="@style/Widget.Luma.ToolbarButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_danger"
        android:text="@string/review_and_approve"
        android:textColor="@color/accent_foreground"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:maxWidth="760dp"
        app:cardBackgroundColor="@color/surface_glass"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <HorizontalScrollView
                android:id="@+id/attachmentTray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachmentList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/attachButton"
                    style="@style/Widget.Luma.ToolbarButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/attach_files"
                    android:text="+"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/taskInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/task_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="6"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <Button
                    android:id="@+id/startTask"
                    style="@style/Widget.Luma.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/send" />

                <Button
                    android:id="@+id/stopTask"
                    style="@style/Widget.Luma.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/stop"
                    android:textColor="@color/status_error"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_glass"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_main_nav" />
</LinearLayout>
