<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Shelly Hermes" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/workspace" android:text="尚未选择工作目录" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/pickDirectory" android:text="选择工作目录（SAF）" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/endpoint" android:hint="模型端点（HTTPS）" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/model" android:hint="模型名称" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/apiKey" android:hint="API Key（加密保存）" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/saveModel" android:text="安全保存模型配置" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/startTask" android:text="启动前台任务" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/approval" android:text="打开审批 / Diff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="会话：就绪" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
