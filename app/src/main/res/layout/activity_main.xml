<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_background"
        app:title="Luma"
        app:titleTextAppearance="@style/TextAppearance.Luma.Title">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settings"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/model_settings"
                android:drawableTop="@android:drawable/ic_menu_preferences"
                android:text="" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@color/surface_background"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12">

            <TextView
                android:id="@+id/workspace"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:gravity="center_vertical"
                android:maxWidth="@dimen/workspace_selector_max_width"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:singleLine="true"
                android:text="@string/no_project"
                android:textAppearance="@style/TextAppearance.Luma.Caption" />

            <Button
                android:id="@+id/chooseWorkspace"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/project" />

            <TextView
                android:id="@+id/modelStatus"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:maxWidth="@dimen/model_status_max_width"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/model_disconnected"
                android:textAppearance="@style/TextAppearance.Luma.Caption" />

            <Button
                android:id="@+id/taskMode"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="ACT" />

            <Button
                android:id="@+id/agentProfile"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="Coding" />

            <Button
                android:id="@+id/taskQueue"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/tasks_zero" />

            <Button
                android:id="@+id/resumeTask"
                style="@style/Widget.Luma.ToolbarButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/resume" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/taskStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Luma.Caption"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/contextBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="0.5"
            android:max="100"
            android:progressTint="@color/accent_primary"
            android:progressBackgroundTint="@color/border_subtle"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contextText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/type_micro"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/taskTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_12"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/timelineModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:minHeight="32dp"
            android:maxLines="1"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="模型"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/timelineTool"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:minHeight="32dp"
            android:maxLines="1"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="工具"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/timelineApproval"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:minHeight="32dp"
            android:maxLines="1"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="审批"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/timelineResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:minHeight="32dp"
            android:maxLines="1"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:text="结果"
            android:textSize="@dimen/type_micro"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/artifactGalleryScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/surface_background"
            android:fillViewport="true"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/artifactGalleryList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_8" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_16"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/line_spacing_relaxed"
            android:padding="@dimen/space_32"
            android:text="@string/start_task"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.Luma.Body"
            android:textColor="@color/text_secondary" />
    </FrameLayout>

    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:background="@drawable/bg_chip_warning"
        android:accessibilityLiveRegion="polite"
        android:minHeight="@dimen/touch_target"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_12"
        android:text="@string/offline_banner"
        android:textAlignment="viewStart"
        android:textColor="@color/status_warning"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:maxWidth="@dimen/workspace_card_max_width"
        android:background="@drawable/bg_chip_error"
        android:accessibilityLiveRegion="assertive"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/status_error" />

        <Button
            android:id="@+id/retry"
            style="@style/Widget.Luma.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/retry" />

        <Button
            android:id="@+id/startNewTask"
            style="@style/Widget.Luma.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="@dimen/space_8"
            android:text="输入新任务"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stoppedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:maxWidth="@dimen/workspace_card_max_width"
        android:background="@drawable/bg_chip_warning"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/stoppedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/status_warning" />

        <Button
            android:id="@+id/resumeStoppedTask"
            style="@style/Widget.Luma.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/resume" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/setupContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:maxWidth="@dimen/workspace_card_max_width"
        android:background="@drawable/bg_chip_warning"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/setupText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/status_warning" />

        <Button
            android:id="@+id/setupAction"
            style="@style/Widget.Luma.ToolbarButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/approval"
        style="@style/Widget.Luma.ToolbarButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:background="@drawable/bg_button_danger"
        android:text="@string/review_and_approve"
        android:textColor="@color/accent_foreground"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:maxWidth="@dimen/workspace_card_max_width"
        app:cardBackgroundColor="@color/surface_glass"
        app:cardCornerRadius="@dimen/radius_pill"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="@dimen/border_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <HorizontalScrollView
                android:id="@+id/attachmentTray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachmentList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/space_4" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/attachButton"
                    style="@style/Widget.Luma.ToolbarButton"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/attach_files"
                    android:text="+"
                    android:textSize="@dimen/type_title"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/taskInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/task_hint"
                    android:imeActionLabel="@string/send"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="6"
                    android:minHeight="@dimen/touch_target"
                    android:padding="@dimen/space_12"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <Button
                    android:id="@+id/startTask"
                    style="@style/Widget.Luma.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:text="@string/send" />

                <Button
                    android:id="@+id/stopTask"
                    style="@style/Widget.Luma.ToolbarButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_8"
                    android:contentDescription="@string/stop_current_task"
                    android:text="@string/stop"
                    android:textColor="@color/status_error"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:background="@color/surface_glass"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_main_nav" />
</LinearLayout>
