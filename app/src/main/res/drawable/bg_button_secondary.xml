<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass_pressed" />
            <stroke android:width="@dimen/border_width" android:color="@color/border_subtle" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass" />
            <stroke android:width="@dimen/border_width" android:color="@color/border_subtle" />
            <corners android:radius="@dimen/radius_small" />
        </shape>
    </item>
</selector>
